# Copy to .env and adjust. docker compose reads .env automatically.
# Every value has a dev default in compose.yaml, so .env is optional locally.

# --- MySQL ---
MYSQL_DATABASE=blogspot
MYSQL_USER=blogspot
MYSQL_PASSWORD=blogspot-dev-password
MYSQL_ROOT_PASSWORD=root-dev-password

# --- blog-api ---
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-dev-only-secret
JWT_EXPIRE_MINUTES=60
LOG_LEVEL=info

# --- web ---
WEB_PORT=8080
